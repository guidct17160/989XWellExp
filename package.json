{
  "name": "wellx989-monorepo",
  "version": "1.0.0",
  "description": "WellX989 Enterprise HR Application",
  "scripts": {
    "start:backend": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend run dev",
    "start:frontend": "npm --prefix frontend run dev",
    "start:app": "npm --prefix app start",
    "dev:app": "npm --prefix app run web",
    "dev:all": "concurrently -k -i --default-input-target app -n backend,web,app -c blue,green,magenta \"npm:dev:backend\" \"npm:start:frontend\" \"npm:start:app\"",
    "dev": "npm run dev:all",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "test:e2e:critical": "npm --prefix frontend run test:e2e:critical"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
