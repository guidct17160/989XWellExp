# =================================================================
# WellX989 Enterprise Environment Configuration Template
# Copy this file to .env and replace with your production credentials
# =================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=wellx989_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend API Configuration
PORT=5000
NODE_ENV=production
DATABASE_URL=postgres://postgres:your_secure_postgres_password@localhost:5432/wellx989_db

# Cryptographic Keys (Keep Secret!)
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
